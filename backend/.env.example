# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shareshelf?retryWrites=true&w=majority

# Auth
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# OTP / SMS (Twilio or MSG91 - stub works without real keys in dev)
OTP_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email (Nodemailer / SendGrid - stub logs to console in dev)
EMAIL_PROVIDER=stub
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ShareShelf <no-reply@shareshelf.app>

# File storage (Cloudinary example - stub stores locally in dev)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Geo defaults
DEFAULT_SEARCH_RADIUS_KM=20

# Admin bootstrap (used by seed script)
ADMIN_EMAIL=admin@shareshelf.app
ADMIN_PASSWORD=Admin@12345
